# =============================================================================
# TV PlayPix — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commite .env.local. Gere segredos com: npm run secrets
# =============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Ignora RLS — nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ---------------------------------------------------------------
APP_URL=http://localhost:3000
# Protege /api/jobs/run (Vercel Cron envia "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=
# 32 bytes em base64 — cifra as senhas dos acessos no banco. Não troque depois
# de entrar em produção (as senhas antigas deixariam de abrir).
CREDENTIALS_ENCRYPTION_KEY=
# Libera o simulador de vendas em /admin/webhooks. Use "false" em produção.
ALLOW_TEST_TOOLS=true
WORKER_BATCH_SIZE=10

# --- Kirvano -----------------------------------------------------------------
# Token configurado no webhook da Kirvano. URL do webhook: $APP_URL/api/webhooks/kirvano
KIRVANO_WEBHOOK_TOKEN=
# Cabeçalho em que a Kirvano envia o token (confirmar na conta).
KIRVANO_TOKEN_HEADER=x-kirvano-token

# --- Sigma BizzPlay ----------------------------------------------------------
# Somente "mock" até recebermos a documentação oficial.
SIGMA_MODE=mock
SIGMA_API_URL=
SIGMA_API_KEY=
# 0 a 1 — fração de chamadas simuladas que falham (testar retentativas).
SIGMA_MOCK_FAILURE_RATE=0
# Endereço do servidor enviado ao cliente junto com usuário/senha (opcional).
ACCESS_SERVER_URL=

# --- WhatsApp Cloud API (Meta) — disabled | mock | live ----------------------
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- E-mail (Resend) — disabled | mock | live --------------------------------
EMAIL_MODE=mock
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
